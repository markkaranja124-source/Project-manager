{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-manager",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BACKEND_URL": "https://buffer-christina-theaters-abilities.trycloudflare.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
