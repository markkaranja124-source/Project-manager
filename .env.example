# Server Configuration
PORT=3000
NODE_ENV=development
BASE_SERVER_URL=http://localhost:3000

# Database Configuration (MySQL / MariaDB / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waiter_attendance_db

# Session Security
SESSION_SECRET=your_session_secret_key_here

# Default Manager Credentials (Initial Seed)
DEFAULT_MANAGER_NAME=Executive Manager
DEFAULT_MANAGER_EMAIL=manager@executive.com
DEFAULT_MANAGER_PASSWORD=Manager123!

# WhatsApp Reports Dispatch (Twilio / Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MANAGER_WHATSAPP_NUMBER=whatsapp:+254700000000
META_WHATSAPP_TOKEN=your_meta_whatsapp_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
